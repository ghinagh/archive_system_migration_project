// ============================================================
// RELATIONSHIPS
// Derived from FK references, stored procedures, and views
// ============================================================

// ARTICLE -> MAIN  (article belongs to a main record)
Ref: ARTICLE.ART_APP_NO - main.MN_APP_NO

// BOOK -> MAIN  (book entry maps to a main record)
Ref: BOOK.BK_APP_NO - main.MN_APP_NO

// RES -> MAIN  (result/resource belongs to main)
Ref: RES.RES_APP_NO > main.MN_APP_NO

// RES -> AUTHER  (resource/author resolution)
Ref: RES.RES_RES_NO > AUTHER.AUT_NO

// ISTARA -> MAIN  (loan/borrow references a main document via book)
Ref: ISTARA.iar_book > main.MN_APP_NO

// ISTARA -> PERSON  (borrower is a person)
Ref: ISTARA.IAR_PRS > PERSON.PRS_NO

// ISTARA -> BOOK  (borrowed item is a book)
Ref: ISTARA.iar_book > BOOK.BK_APP_NO

// ARTICLE -> PERIOD  (article published in a periodical)
Ref: ARTICLE.ART_PER_NO > PERIOD.PER_PER_NO

// TRANS -> PERIOD  (transaction linked to a period)
Ref: TRANS.TRS_NO > PERIOD.PER_PER_NO

// DIGIT -> MAIN  (digitization entry for a main document)
Ref: DIGIT.DIG_NO > main.MN_APP_NO

// ANALIS -> MAIN  (analysis entry for a main document)
Ref: ANALIS.AN_APP_NO > main.MN_APP_NO

// ANALIS -> MACNZ  (analysis references a macnz subject code)
Ref: ANALIS.AN_DESC_NO > MACNZ.SUB_CODE

// NAROWER -> MAIN  (narrower term for a main document)
Ref: NAROWER.NAR_APP_NO > main.MN_APP_NO

// NAROWER -> MACNZ  (narrower term references macnz)
Ref: NAROWER.NAR_NAR_NO > MACNZ.SUB_CODE

// RELATIVE -> MAIN  (related term for a main document)
Ref: RELATIVE.REL_APP_NO > main.MN_APP_NO

// RELATIVE -> MACNZ  (relative term references macnz)
Ref: RELATIVE.REL_REL_NO > MACNZ.SUB_CODE

// GEO -> MAIN  (geographic descriptor for main document)
Ref: GEO.GEO_APP_NO > main.MN_APP_NO

// FILE_ADD -> MAIN  (file addendum for main document)
Ref: FILE_ADD.FAD_APP_NO > main.MN_APP_NO

// TEXT -> MAIN  (text/memo for main document)
Ref: TEXT.TXT_APP_NO > main.MN_APP_NO

// OPR_CHRT -> CHARIT  (operation chart references a chart/archive)
Ref: OPR_CHRT.OPR_NO1 > CHARIT.CHA_NO

// SUBJECT -> form  (subject links a form entry)
Ref: SUBJECT.SUB_FORM > form.SUB_NO

// SUBJECT -> MACNZ  (subject references a macnz code)
Ref: SUBJECT.SUB_MCNZ > MACNZ.SUB_CODE

// REL_FORM -> form  (relation between two form entries)
Ref: REL_FORM.RLF_FORM1 > form.SUB_NO
Ref: REL_FORM.RLF_FORM2 > form.SUB_NO

// REL_FORM -> POSITION  (form 1 may also reference a position)
Ref: REL_FORM.RLF_FORM1 > POSITION.POS_NO

// user_bnkout -> bnkout  (user output selection)
Ref: user_bnkout.user_out_num > bnkout.OUT_NUM

// catogorie -> bnkout  (category linked to bnkout output)
Ref: catogorie.cat_num > bnkout.OUT_NUM

// demand -> main  (demand/request references main document via mch_no)
Ref: demand.dmd_mch_no > main.MN_APP_NO

// demand -> config  (demand linked to a user config)
Ref: demand.dmd_user > config.user_no

// posts -> form  (post references a form entry by post_no -> sub_cod)
Ref: posts.post_no > form.SUB_NO

// sites -> form  (site references a form entry)
Ref: sites.sit_no > form.SUB_NO

// IST_BK -> ISTARA  (istara book link)
Ref: IST_BK.IAB_NO > ISTARA.IAR_NO

// IST_BK -> BOOK  (istara book references a book)
Ref: IST_BK.IAB_BOOK > BOOK.BK_APP_NO

// BOOK -> AUTHER  (publisher is an author/entity)
Ref: BOOK.BK_PBLSHR > AUTHER.AUT_NO

// SERIES -> main  (series entry for a main document)
Ref: SERIES.SER_APP_NO > main.MN_APP_NO

// date_subject -> main
Ref: date_subject.dte_app_no > main.MN_APP_NO

// text1 -> main
Ref: text1.txt_no > main.MN_APP_NO

// result -> DIGIT
Ref: result.res_dig_no > DIGIT.DIG_DIG_NO

// tmp_fileadd -> config
Ref: tmp_fileadd.tmp_user_no > config.user_no

